def get_data_for_network(input_file, target_subreddits,out_file):
    
    with open(input_file, 'rb') as f, open (out_file, 'w', newline = '', encoding='utf-8') as f_out:           #Open file, read as bytes not text
        writer = csv.writer(f_out)                                                                             #Initialize CSV
        writer.writerow(['author','parent_id','subreddit'])

        dctx = zstd.ZstdDecompressor(max_window_size=2**31)                                                    #Create decompression context
        stream_reader = dctx.stream_reader(f)                                                                  #Reade bytes in the context defined above, decompression them.  Does so incrementally (Streaming)
        text_stream= io.TextIOWrapper(stream_reader, encoding = 'utf-8')                                       #wrap to text 

        #c= 0                                                                                                  #c and corresponding if statment are intended as a limiter to test a subset of the data
        for line in text_stream:
            try:
                obj = json.loads(line)
                subreddit = obj.get("subreddit", "").lower()

                if subreddit in target_subreddits:                                                        
                    #Extract fields and write
                    a = obj.get("author")
                    b = obj.get("parent_id")
                    if (a != "[deleted]" and b != "[deleted]"):
                        writer.writerow([
                            a,
                            b,
                            subreddit
                    ])
                    #c = c+1
                   # if c >1000:
                   #     break
            except:
                continue
