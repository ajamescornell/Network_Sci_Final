def plot_infection_curve(curve, total_nodes, label="Network"):
    percent_infected = [(x / total_nodes) * 100 for x in curve]

    plt.figure()
    plt.plot(percent_infected)
    plt.xlabel("Time Step")
    plt.ylabel("Percent Infected (%)")
    plt.title(f"SI Spread - {label}")
    plt.grid()
    plt.show()



