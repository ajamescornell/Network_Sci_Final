def run_sr_simulation(G, beta=0.05, gamma=0.02, max_steps=50):
    nodes = list(G.nodes())
    
        infected = set([random.choice(nodes)])
    recovered = set()
    
    S_counts = [len(nodes) - 1]
    I_counts = [1]
    R_counts = [0]

    for step in range(max_steps):
        new_infected = set()
        new_recovered = set()

        # Infection step
        for node in infected:
            for nbr in G.neighbors(node):
                if nbr not in infected and nbr not in recovered:
                    if random.random() < beta:
                        new_infected.add(nbr)

        # Recovery step
        for node in infected:
            if random.random() < gamma:
                new_recovered.add(node)

        # Update states
        infected = (infected | new_infected) - new_recovered
        recovered = recovered | new_recovered

        # Track counts
        S_counts.append(len(nodes) - len(infected) - len(recovered))
        I_counts.append(len(infected))
        R_counts.append(len(recovered))

        # Stop if no more infections
        if len(infected) == 0:
            break

    return S_counts, I_counts, R_counts



