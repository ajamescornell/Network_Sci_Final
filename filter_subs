""""
Optional function to filter out specific subreddits from the larger list of subreddits 
declared in get_csv 
""""


def filtered_network (inputcsv, Filter_Subs,out_csv_name):
    outcsv = out_csv_name

    with open(inputcsv, newline = '', encoding='utf-8') as infile, \
        open(outcsv, 'w', newline = '', encoding='utf-8') as outfile:

        read = csv.reader(infile)
        write = csv.writer(outfile)
        
        write.writerow(["Source", "Target", "Color"] )
        for row in read:
            if row[2] in Filter_Subs:
                write.writerow(row)



